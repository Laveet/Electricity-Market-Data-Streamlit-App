# Copy this file to `.env` (already in .gitignore) and fill in your own key.
# Never commit the real .env file or paste your key into any tracked file.
#
# Get an ENTSO-E Transparency Platform API key:
#   1. Register at https://transparency.entsoe.eu/
#   2. Log in -> My Account Settings -> Web API Security Token -> Generate/Save Token
ENTSOE_API_KEY=

# Optional: Slack/webhook URL for pipeline alerts (leave blank if unused)
SLACK_WEBHOOK_URL=
